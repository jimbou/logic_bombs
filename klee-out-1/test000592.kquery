array bc_expr[64] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 0 bc_expr)))
         (Sle 32 N1:(SExt w32 N0))
         (Sle N1 126)
         (Eq false
             (Eq 0 N2:(Read w8 1 bc_expr)))
         (Sle 32 N3:(SExt w32 N2))
         (Sle N3 126)
         (Eq 0 (Read w8 2 bc_expr))
         (Eq false (Eq 92 N2))
         (Or (Eq 122 N0)
             (Or (Eq 121 N0)
                 (Or (Eq 120 N0)
                     (Or (Eq 118 N0)
                         (Or (Eq 117 N0)
                             (Or (Eq 116 N0)
                                 (Or (Eq 113 N0)
                                     (Or (Eq 110 N0)
                                         (Or (Eq 109 N0)
                                             (Or (Eq 107 N0)
                                                 (Or (Eq 106 N0)
                                                     (Or (Eq 103 N0) (Eq 101 N0)))))))))))))
         (Eq false (Eq 97 N0))
         (Eq false (Eq 98 N0))
         (Eq false (Eq 99 N0))
         (Eq false (Eq 100 N0))
         (Eq false (Eq 102 N0))
         (Eq false (Eq 105 N0))
         (Eq false (Eq 108 N0))
         (Eq false (Eq 114 N0))
         (Eq false (Eq 119 N0))
         (Eq false (Eq 104 N0))
         (Eq false (Eq 111 N0))
         (Eq false (Eq 115 N0))
         (Eq false (Eq 112 N0))]
        false)
