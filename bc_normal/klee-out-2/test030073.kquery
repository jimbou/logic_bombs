array bc_stdin_bytes[128] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 10 N0:(Read w8 0 bc_stdin_bytes)))
         (Eq false (Eq 9 N0))
         (Eq false (Eq 32 N0))
         (Sle 32 N1:(ZExt w32 N0))
         (Sle N1 126)
         (Eq 10 (Read w8 1 bc_stdin_bytes))
         (Eq 10 (Read w8 2 bc_stdin_bytes))
         (Eq 32 (Read w8 3 bc_stdin_bytes))
         (Eq 9 (Read w8 4 bc_stdin_bytes))
         (Eq 9 (Read w8 5 bc_stdin_bytes))
         (Eq 9 (Read w8 6 bc_stdin_bytes))
         (Eq 9 (Read w8 7 bc_stdin_bytes))]
        false)
