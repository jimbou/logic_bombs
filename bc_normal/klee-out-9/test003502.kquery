array bc_expr[64] : w32 -> w8 = symbolic
(query [(Eq 92
             (Extract w8 0 (Add w32 32
                                    (URem w32 (ZExt w32 (Read w8 62 bc_expr))
                                              95))))
         (Eq 99
             (Extract w8 0 (Add w32 32
                                    (URem w32 (ZExt w32 (Read w8 0 bc_expr))
                                              95))))
         (Eq false
             (Eq 111
                 N0:(Extract w8 0 (Add w32 32
                                           (URem w32 (ZExt w32 (Read w8 1 bc_expr))
                                                     95)))))
         (Sle 97 N1:(SExt w32 N0))
         (Sle N1 122)
         (Sle 97
              N2:(SExt w32 (Extract w8 0 (Add w32 32
                                                  (URem w32 (ZExt w32 (Read w8 2 bc_expr))
                                                            95)))))
         (Sle N2 122)
         (Sle 97
              N3:(SExt w32 (Extract w8 0 (Add w32 32
                                                  (URem w32 (ZExt w32 (Read w8 3 bc_expr))
                                                            95)))))
         (Eq false (Sle N3 122))]
        false)
