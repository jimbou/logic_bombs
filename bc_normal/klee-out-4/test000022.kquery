array bc_stdin[64] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 0 bc_stdin)))
         (Sle 32 N1:(SExt w32 N0))
         (Sle N1 126)
         (Eq 0 (Read w8 1 bc_stdin))
         (Eq 0 (Read w8 2 bc_stdin))
         (Eq 0 (Read w8 3 bc_stdin))
         (Eq false
             (Eq 0 N2:(Read w8 4 bc_stdin)))
         (Eq false
             (Sle 32 (SExt w32 N2)))]
        false)
