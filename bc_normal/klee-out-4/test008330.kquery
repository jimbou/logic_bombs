array bc_stdin[64] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 0 bc_stdin))
         (Eq false
             (Eq 0 N0:(Read w8 1 bc_stdin)))
         (Sle 32 N1:(SExt w32 N0))
         (Sle N1 126)
         (Eq 0 (Read w8 2 bc_stdin))
         (Eq false
             (Eq 0 N2:(Read w8 3 bc_stdin)))
         (Sle 32 N3:(SExt w32 N2))
         (Sle N3 126)
         (Eq false
             (Eq 0 N4:(Read w8 4 bc_stdin)))
         (Sle 32 N5:(SExt w32 N4))
         (Sle N5 126)
         (Eq false
             (Eq 0 N6:(Read w8 5 bc_stdin)))
         (Sle 32 N7:(SExt w32 N6))
         (Sle N7 126)
         (Eq 0 (Read w8 6 bc_stdin))
         (Eq 0 (Read w8 7 bc_stdin))
         (Eq 0 (Read w8 8 bc_stdin))
         (Eq 0 (Read w8 9 bc_stdin))
         (Eq false
             (Eq 0 N8:(Read w8 10 bc_stdin)))
         (Sle 32 N9:(SExt w32 N8))
         (Sle N9 126)
         (Eq 0 (Read w8 11 bc_stdin))
         (Eq 0 (Read w8 12 bc_stdin))
         (Eq 0 (Read w8 13 bc_stdin))]
        false)
