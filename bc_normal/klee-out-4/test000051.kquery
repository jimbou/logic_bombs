array bc_stdin[64] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 0 bc_stdin))
         (Eq 0 (Read w8 1 bc_stdin))
         (Eq 0 (Read w8 2 bc_stdin))
         (Eq 0 (Read w8 3 bc_stdin))
         (Eq 0 (Read w8 4 bc_stdin))
         (Eq 0 (Read w8 5 bc_stdin))
         (Eq false
             (Eq 0 N0:(Read w8 6 bc_stdin)))
         (Eq false
             (Sle 32 (SExt w32 N0)))]
        false)
