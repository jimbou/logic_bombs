array model_version[4] : w32 -> w8 = symbolic
array xml_input[128] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 61371
             (Or w32 (Shl w32 (ZExt w32 (Read w8 0 xml_input))
                              8)
                     (ZExt w32 (Read w8 1 xml_input))))
         (Eq false
             (Eq 191 N0:(Read w8 2 xml_input)))
         (Eq false
             (Eq 0
                 (And w32 N1:(ZExt w32 N0) 128)))
         (Eq false
             (Eq 192 (And w32 N1 192)))]
        false)
