array model_version[4] : w32 -> w8 = symbolic
array xml_input[128] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 15360
             (Or w32 (Shl w32 (ZExt w32 (Read w8 0 xml_input))
                              8)
                     (ZExt w32 (Read w8 1 xml_input))))
         (Eq 0 (Read w8 3 xml_input))
         (Eq 16
             (Read w8 (Extract w32 0 (Add w64 136
                                              (ZExt w64 (Read w8 2 xml_input))))
                      const_arr1))
         (Eq 0 (Read w8 5 xml_input))
         (Or (Eq 22
                 N0:(Read w8 (Extract w32 0 (Add w64 136
                                                     (ZExt w64 (Read w8 4 xml_input))))
                             const_arr1))
             (Eq 24 N0))
         (Eq false
             (Eq 0 (Read w8 7 xml_input)))]
        false)
