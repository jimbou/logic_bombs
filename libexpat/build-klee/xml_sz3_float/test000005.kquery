                                                              (SExt w64 (Add w32 (Shl w32 (ZExt w32 (Read w8 (Extract w32 0 (ZExt w64 N0))
                                                                                                             const_arr4))
                                                                                          3)
                                                                                 (AShr w32 N2:(ZExt w32 (Read w8 3 xml_input))
                                                                                           5))))) const_arr5)
                      (Shl w32 1 (And w32 N2 31))))]
