         (Eq false (Eq 216 N0))
         (Eq false (Eq 219 N0))
         (Eq false (Eq 217 N0))
         (Eq false (Eq 223 N0))
         (Eq false (Eq 255 N0))
         (Eq false (Eq 220 N0))
