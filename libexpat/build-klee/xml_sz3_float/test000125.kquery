array model_version[4] : w32 -> w8 = symbolic
array xml_input[128] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 61371
             (Or w32 (Shl w32 (ZExt w32 (Read w8 0 xml_input))
                              8)
                     (ZExt w32 (Read w8 1 xml_input))))
         (Eq 191 (Read w8 2 xml_input))
         (Eq 30
             (Read w8 (Extract w32 0 (Add w64 136
                                              (ZExt w64 (Read w8 3 xml_input))))
                      const_arr2))
         (Eq 6
             (Read w8 (Extract w32 0 (Add w64 136
                                              (ZExt w64 N0:(Read w8 4 xml_input))))
                      const_arr2))
         (Eq false
             (Eq 0
                 (And w32 N1:(ZExt w32 (Read w8 6 xml_input))
                          128)))
         (Eq false (Eq 239 N0))
         (Eq false
             (Eq 192 (And w32 N1 192)))
         (Eq false (Eq 224 N0))
         (Eq false
             (Eq 0
                 (And w32 N2:(ZExt w32 (Read w8 5 xml_input))
                          128)))
         (Eq false (Eq 237 N0))
         (Eq false
             (Eq 192 (And w32 N2 192)))]
        false)
