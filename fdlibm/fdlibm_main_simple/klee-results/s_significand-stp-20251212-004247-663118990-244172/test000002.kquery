array a0[8] : w32 -> w8 = symbolic
(query [(Eq false
             (Slt N0:(And w32 (ReadLSB w32 0 a0)
                              2147483647)
                  1048576))
         (Eq false (Slt N0 2146435072))
         (Eq 0
             (LShr w32 (Sub w32 2146435072
                                (Or w32 N0
                                        (LShr w32 (Or w32 N1:(ReadLSB w32 4 a0)
                                                          (Sub w32 0 N1))
                                                  31)))
                       31))]
        false)
