array a0[8] : w32 -> w8 = symbolic
(query [(Eq false
             (Slt N0:(ReadLSB w32 0 a0)
                  1048576))
         (Eq false (Sle 2146435072 N0))
         (Eq 2
             (Add w32 N1:(AShr w32 N0 20)
                      (LShr w32 (And w32 (Add w32 4294966273 N1) 2147483648)
                                31)))]
        false)
