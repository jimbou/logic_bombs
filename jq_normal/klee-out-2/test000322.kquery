array json_input[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 2 json_input)))
         (Eq false
             (Eq 0 N1:(Read w8 3 json_input)))
         (Eq 0 (Read w8 4 json_input))
         (Eq 10 (Read w8 1 json_input))
         (Eq 110 (Read w8 0 json_input))
         (Eq 0
             (And w32 (ZExt w32 N0) 128))
         (Eq 0
             (And w32 (ZExt w32 N1) 128))]
        false)
