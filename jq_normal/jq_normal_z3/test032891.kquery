array json_input[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 1 json_input)))
         (Eq false
             (Eq 0 N1:(Read w8 2 json_input)))
         (Eq false
             (Eq 0 (Read w8 4 json_input)))
         (Eq false
             (Eq 0 (Read w8 5 json_input)))
         (Eq false
             (Eq 0 (Read w8 6 json_input)))
         (Eq 0 (Read w8 7 json_input))
         (Eq 91 (Read w8 0 json_input))
         (Eq false (Eq 10 N0))
         (Or (Eq 13 N0)
             (Or (Eq 9 N0) (Eq 32 N0)))
         (Eq false (Eq 10 N1))
         (Eq false (Eq 123 N1))
         (Eq false (Eq 125 N1))
         (Eq false (Eq 91 N1))
         (Eq false (Eq 93 N1))
         (Eq false (Eq 32 N1))
         (Eq false (Eq 34 N1))
         (Eq false (Eq 44 N1))
         (Eq false (Eq 58 N1))
         (Eq false (Eq 9 N1))
         (Eq false (Eq 13 N1))
         (Eq 34 (Read w8 3 json_input))
         (Eq false (Eq 102 N1))
         (Eq false (Eq 110 N1))
         (Eq false (Eq 116 N1))
         (Eq false (Eq 39 N1))]
        false)
