         (Eq 0 (Read w8 10 json_input))
         (Eq false (Eq 239 N0))
         (Eq false (Eq 10 N0))
         (Or (Eq 13 N0)
             (Or (Eq 9 N0) (Eq 32 N0)))
         (Eq false (Eq 10 N1))
