array json_input[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 3 json_input)))
         (Eq 0 (Read w8 4 json_input))
         (Eq false (Eq 10 N0))
         (Or (Eq 58 N0)
             (Or (Eq 44 N0)
                 (Or (Eq 93 N0)
                     (Or (Eq 91 N0)
                         (Or (Eq 125 N0) (Eq 123 N0))))))
         (Eq 46 (Read w8 1 json_input))
         (Eq 48 (Read w8 2 json_input))
         (Eq 50 (Read w8 0 json_input))]
        false)
