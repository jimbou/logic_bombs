         (Eq 0 (Read w8 6 json_input))
         (Eq false (Eq 239 N0))
         (Eq false (Eq 10 N0))
         (Or (Eq 13 N0)
             (Or (Eq 9 N0) (Eq 32 N0)))
         (Eq false (Eq 10 N1))
         (Or (Eq 13 N1)
             (Or (Eq 9 N1) (Eq 32 N1)))
         (Eq false (Eq 10 N2))
         (Or (Eq 13 N2)
             (Or (Eq 9 N2) (Eq 32 N2)))
         (Eq 34 (Read w8 3 json_input))
