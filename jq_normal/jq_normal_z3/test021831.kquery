array json_input[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 3 json_input)))
         (Eq false
             (Eq 0 N1:(Read w8 5 json_input)))
         (Eq 0 (Read w8 6 json_input))
         (Eq 239 (Read w8 0 json_input))
         (Eq 187 (Read w8 1 json_input))
         (Eq 191 (Read w8 2 json_input))
         (Eq false (Eq 10 N0))
         (Eq false (Eq 123 N0))
         (Eq false (Eq 125 N0))
         (Eq false (Eq 91 N0))
         (Eq false (Eq 93 N0))
         (Eq false (Eq 32 N0))
         (Eq false (Eq 34 N0))
         (Eq false (Eq 44 N0))
         (Eq false (Eq 58 N0))
         (Eq false (Eq 9 N0))
         (Eq false (Eq 13 N0))
         (Eq false (Eq 10 N1))
         (Or (Eq 13 N1)
             (Or (Eq 9 N1) (Eq 32 N1)))
         (Eq false (Eq 102 N0))
         (Eq false (Eq 110 N0))
         (Eq false (Eq 116 N0))
         (Eq false (Eq 39 N0))
         (Eq false (Eq 43 N0))
         (Eq false (Eq 45 N0))
         (Eq false (Eq 48 N0))
         (Sle 48 N2:(SExt w32 N0))
         (Eq false (Sle N2 57))
         (Eq false (Eq 101 N0))
         (Eq false (Eq 69 N0))
         (Or (Eq 73 N0) (Eq 105 N0))
         (Eq 110 (Read w8 4 json_input))]
        false)
