array json_input[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 4 json_input)))
         (Eq false
             (Eq 0 (Read w8 7 json_input)))
         (Eq 0 (Read w8 8 json_input))
         (Eq 10 (Read w8 0 json_input))
         (Eq 34 (Read w8 1 json_input))
         (Eq 92 (Read w8 2 json_input))
         (Eq 34 (Read w8 3 json_input))
         (Eq false (Eq 10 N0))
         (Eq false (Eq 34 N0))
         (Eq false (Eq 92 N0))
         (Eq 10 (Read w8 5 json_input))
         (Eq 34 (Read w8 6 json_input))
         (Eq 0
             (And w32 (SExt w32 N0) 4294967264))]
        false)
