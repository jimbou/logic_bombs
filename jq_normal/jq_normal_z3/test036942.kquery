array json_input[256] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 1 json_input)))
         (Eq false
             (Eq 0 N1:(Read w8 2 json_input)))
         (Eq false
             (Eq 0 (Read w8 4 json_input)))
         (Eq false
             (Eq 0 (Read w8 5 json_input)))
         (Eq false
             (Eq 0 (Read w8 6 json_input)))
         (Eq 0 (Read w8 7 json_input))
         (Eq false (Eq 10 N0))
         (Eq false (Eq 123 N0))
         (Eq false (Eq 125 N0))
         (Eq false (Eq 91 N0))
         (Eq false (Eq 93 N0))
         (Eq false (Eq 32 N0))
         (Eq false (Eq 34 N0))
         (Eq false (Eq 44 N0))
         (Eq false (Eq 58 N0))
         (Eq false (Eq 9 N0))
         (Eq false (Eq 13 N0))
         (Eq false (Eq 10 N1))
         (Eq false (Eq 123 N1))
         (Eq false (Eq 125 N1))
         (Eq false (Eq 91 N1))
         (Eq false (Eq 93 N1))
         (Eq false (Eq 32 N1))
         (Eq false (Eq 34 N1))
         (Eq false (Eq 44 N1))
         (Eq false (Eq 58 N1))
         (Eq false (Eq 9 N1))
         (Eq false (Eq 13 N1))
         (Eq 10 (Read w8 3 json_input))
         (Eq 78 (Read w8 0 json_input))
         (Sle 65 N2:(SExt w32 N0))
         (Eq false (Sle N2 90))
         (Eq false (Eq 97 N0))]
        false)
