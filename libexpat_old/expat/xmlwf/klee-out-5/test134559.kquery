array argc[4] : w32 -> w8 = symbolic
array argv_1[16] : w32 -> w8 = symbolic
(query [(Sle 1
              N0:(ReadLSB w32 0 argc))
         (Sle N0 4)
         (Slt 1 N0)
         (Eq false (Slt 2 N0))
         (Eq 45 (Read w8 0 argv_1))
         (Eq 114 (Read w8 1 argv_1))
         (Eq 109 (Read w8 2 argv_1))
         (Eq 116 (Read w8 3 argv_1))
         (Eq false
             (Eq 113 N1:(Read w8 4 argv_1)))
         (Eq false (Eq 115 N1))
         (Eq false (Eq 0 N1))
         (Eq false (Eq 119 N1))
         (Eq false (Eq 120 N1))
         (Eq false (Eq 99 N1))
         (Eq false (Eq 116 N1))
         (Eq false (Eq 101 N1))
         (Eq false (Eq 110 N1))
         (Eq false (Eq 78 N1))
         (Eq false (Eq 103 N1))
         (Eq false (Eq 107 N1))
         (Eq false (Eq 98 N1))
         (Eq false (Eq 109 N1))
         (Eq false (Eq 100 N1))
         (Eq false (Eq 112 N1))
         (Eq false (Eq 104 N1))
         (Eq false (Eq 118 N1))
         (Eq false (Eq 114 N1))
         (Eq false (Eq 97 N1))]
        false)
