array arg0[33] : w32 -> w8 = symbolic
array model_version[4] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 45 (Read w8 0 arg0))
         (Eq 78 (Read w8 1 arg0))
         (Eq 98 (Read w8 2 arg0))
         (Eq 45 (Read w8 3 arg0))
         (Sle (ZExt w32 (Extract w8 0 (Add w32 4294967248
                                               (SExt w32 (Read w8 4 arg0)))))
              9)
         (Eq false
             (Sle (ZExt w32 (Extract w8 0 (Add w32 4294967248
                                                   N0:(SExt w32 (Read w8 5 arg0)))))
                  9))
         (Sle 65 N0)]
        false)
