array arg0[33] : w32 -> w8 = symbolic
array model_version[4] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 45 (Read w8 0 arg0))
         (Eq 78 (Read w8 1 arg0))
         (Eq 114 (Read w8 2 arg0))
         (Eq 119 (Read w8 3 arg0))
         (Eq 0 (Read w8 4 arg0))]
        false)
