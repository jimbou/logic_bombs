array bc_expr[64] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 0 bc_expr)))
         (Sle 32 N1:(SExt w32 N0))
         (Sle N1 126)
         (Eq false
             (Eq 0 N2:(Read w8 1 bc_expr)))
         (Sle 32 N3:(SExt w32 N2))
         (Sle N3 126)
         (Eq false
             (Eq 0 N4:(Read w8 2 bc_expr)))
         (Sle 32 N5:(SExt w32 N4))
         (Sle N5 126)
         (Eq false
             (Eq 0 N6:(Read w8 3 bc_expr)))
         (Sle 32 N7:(SExt w32 N6))
         (Sle N7 126)
         (Eq 0 (Read w8 4 bc_expr))
         (Eq false (Eq 92 N6))
         (Or (Eq 125 N0) (Eq 123 N0))]
        false)
