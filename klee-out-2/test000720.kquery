array bc_expr[64] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 1 bc_expr)))
         (Sle 32 N1:(SExt w32 N0))
         (Sle N1 126)
         (Eq 0 (Read w8 2 bc_expr))
         (Eq false (Eq 92 N0))
         (Eq 97 (Read w8 0 bc_expr))
         (Eq false (Eq 117 N0))
         (Eq false (Eq 98 N0))
         (Eq false (Eq 115 N0))
         (Sle 97 N1)
         (Eq false (Sle N1 122))]
        false)
