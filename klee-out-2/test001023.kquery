array bc_expr[64] : w32 -> w8 = symbolic
(query [(Eq false
             (Eq 0 N0:(Read w8 2 bc_expr)))
         (Sle 32 N1:(SExt w32 N0))
         (Sle N1 126)
         (Eq 0 (Read w8 4 bc_expr))
         (Eq 92 (Read w8 3 bc_expr))
         (Eq 32 (Read w8 0 bc_expr))
         (Eq 34 (Read w8 1 bc_expr))
         (Eq false (Eq 34 N0))]
        false)
