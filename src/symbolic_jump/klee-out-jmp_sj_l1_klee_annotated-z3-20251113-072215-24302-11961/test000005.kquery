array s[5] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 4 s))
         (Eq 1
             (SRem w32 N0:(Add w32 4294967248
                                   (SExt w32 N1:(Read w8 0 s)))
                       6))
         (Eq false (Slt N0 10))
         (Eq false (Slt 40 N0))
         (Eq false (Eq 67 N1))]
        false)
