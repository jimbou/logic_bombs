array model_version[4] : w32 -> w8 = symbolic
array symvar[1] : w32 -> w8 = symbolic
array x[4] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 0 symvar))
         (Eq false
             (And (FOEq (FAdd w32 1.024E+3
                                  N0:(FPTrunc w32 (FDiv w64 (FPExt w64 (ReadLSB w32 0 x))
                                                            -1.0E+4)))
                        1.024E+3)
                  (FOGt N0 0.0E+0)))]
        false)
