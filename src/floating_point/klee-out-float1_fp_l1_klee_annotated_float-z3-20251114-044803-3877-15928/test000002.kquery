array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Eq false
             (FOEq (FSub w32 (FPTrunc w32 (FDiv w64 (SIToFP w64 (Add w32 4294967248
                                                                         (SExt w32 (Read w8 0 s))))
                                                    7.0E+1))
                             1036831949)
                   0.0E+0))]
        false)
