array model_version[4] : w32 -> w8 = symbolic
array s[33] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 32 s))
         (Eq false
             (Eq 0 (Read w8 0 s)))
         (Eq false
             (Eq 0 (Read w8 1 s)))
         (Eq false
             (Eq 0 (Read w8 2 s)))
         (Eq false
             (Eq 0 (Read w8 3 s)))
         (Eq false
             (Eq 0 (Read w8 4 s)))
         (Eq false
             (Eq 0 (Read w8 5 s)))
         (Eq false
             (Eq 0 (Read w8 6 s)))
         (Eq false
             (Eq 0 (Read w8 7 s)))
         (Eq false
             (Eq 0 (Read w8 8 s)))
         (Eq false
             (Eq 0 (Read w8 9 s)))
         (Eq false
             (Eq 0 (Read w8 10 s)))
         (Eq false
             (Eq 0 (Read w8 11 s)))
         (Eq false
             (Eq 0 (Read w8 12 s)))
         (Eq false
             (Eq 0 (Read w8 13 s)))
         (Eq 0 (Read w8 14 s))]
        false)
