                                                                      (SRem w64 N5:(Sub w64 (Mul w64 16807
                                                                                                     (SRem w64 N6:(Add w64 2147483647 N1) 127773))
                                                                                            (Mul w64 2836 (SDiv w64 N6 127773)))
                                                                                127773))
                                                             (Mul w64 2836 (SDiv w64 N5 127773)))
                                                 127773))
                              (Mul w64 2836 (SDiv w64 N4 127773)))
                  0))
         (Eq false
             (Slt N7:(Sub w64 (Mul w64 16807 (SRem w64 N3 127773))
                              (Mul w64 2836 (SDiv w64 N3 127773)))
                  0))
         (Slt N8:(Sub w64 (Mul w64 16807 (SRem w64 N7 127773))
