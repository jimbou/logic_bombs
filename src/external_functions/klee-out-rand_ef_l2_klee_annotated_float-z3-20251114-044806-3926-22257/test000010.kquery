array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Eq false
             (Eq 0 N0:(Read w8 0 s)))
         (Slt N1:(Sub w64 (Mul w64 16807
                                   (SRem w64 N2:(ZExt w64 (SExt w32 N0))
                                             127773))
                          (Mul w64 2836 (SDiv w64 N2 127773)))
              0)
         (Slt (Sub w64 (Mul w64 16807
                                (SRem w64 N3:(Sub w64 (Mul w64 16807
                                                               (SRem w64 N4:(Sub w64 (Mul w64 16807
                                                                                              (SRem w64 N5:(Add w64 2147483647 N1) 127773))
                                                                                     (Mul w64 2836 (SDiv w64 N5 127773)))
                                                                         127773))
                                                      (Mul w64 2836 (SDiv w64 N4 127773)))
                                          127773))
                       (Mul w64 2836 (SDiv w64 N3 127773)))
              0)]
        false)
