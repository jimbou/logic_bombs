array model_version[4] : w32 -> w8 = symbolic
array symvar[257] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 256 symvar))
         (Eq false
             (Eq 0 (Read w8 0 symvar)))
         (Eq false
             (Eq 0 (Read w8 1 symvar)))
         (Eq false
             (Eq 0 (Read w8 2 symvar)))
         (Eq 0 (Read w8 3 symvar))]
        false)
