array model_version[4] : w32 -> w8 = symbolic
array s[17] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 16 s))
         (Eq 47 (Read w8 0 s))
         (Eq 47 (Read w8 1 s))
         (Eq 255 (Read w8 2 s))
         (Eq 255 (Read w8 3 s))
         (Eq 0 (Read w8 4 s))]
        false)
