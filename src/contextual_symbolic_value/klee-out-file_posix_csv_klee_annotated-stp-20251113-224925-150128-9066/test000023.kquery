array s[17] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 16 s))
         (Eq 47 (Read w8 0 s))
         (Eq 104 (Read w8 1 s))
         (Eq 111 (Read w8 2 s))
         (Eq 109 (Read w8 3 s))
         (Eq false
             (Eq 101 N0:(Read w8 4 s)))
         (Eq false (Eq 0 N0))
         (Eq false (Eq 47 N0))
         (Eq 0 (Read w8 5 s))]
        false)
