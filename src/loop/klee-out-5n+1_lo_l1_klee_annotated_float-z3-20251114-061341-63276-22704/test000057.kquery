array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Eq false
             (Eq 0
                 (SRem w64 N0:(SExt w64 (Add w32 46
                                                 (SExt w32 (Read w8 0 s))))
                           2)))
         (Eq false
             (Eq 0 (SRem w64 N0 3)))
         (Eq 0
             (SRem w64 N1:(SDiv w64 (Add w64 1 (Mul w64 3 N0))
                                    2)
                       2))
         (Eq false
             (Eq 1 N2:(SDiv w64 N1 2)))
         (Eq false
             (Eq 0 (SRem w64 N2 2)))
         (Eq 0
             (SRem w64 N3:(SDiv w64 (Add w64 1 (Mul w64 3 N2))
                                    2)
                       2))
         (Eq 0
             (SRem w64 N4:(SDiv w64 N3 2) 2))
         (Eq 0
             (SRem w64 N5:(SDiv w64 N4 2) 2))
         (Eq 0
             (SRem w64 (SDiv w64 N5 2) 2))]
        false)
