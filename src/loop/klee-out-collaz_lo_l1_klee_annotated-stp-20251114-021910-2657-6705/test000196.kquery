array s[5] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 4 s))
         (Eq false
             (Eq 0
                 (SRem w32 N0:(Add w32 46
                                       (SExt w32 (Read w8 0 s)))
                           2)))
         (Eq false
             (Eq 0
                 (SRem w32 N1:(SDiv w32 (Add w32 1 (Mul w32 3 N0))
                                        2)
                           2)))
         (Eq false
             (Eq 0
                 (SRem w32 N2:(SDiv w32 (Add w32 1 (Mul w32 3 N1))
                                        2)
                           2)))
         (Eq false
             (Eq 0
                 (SRem w32 N3:(SDiv w32 (Add w32 1 (Mul w32 3 N2))
                                        2)
                           2)))
         (Eq 0
             (SRem w32 N4:(SDiv w32 (Add w32 1 (Mul w32 3 N3))
                                    2)
                       2))
         (Eq 0
             (SRem w32 N5:(SDiv w32 N4 2) 2))
         (Eq 0
             (SRem w32 N6:(SDiv w32 N5 2) 2))
         (Eq false
             (Eq 0
                 (SRem w32 (SDiv w32 N6 2) 2)))]
        false)
