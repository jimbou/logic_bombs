array s[5] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 4 s))
         (Eq false
             (Eq 0
                 (SRem w64 N0:(SExt w64 (Add w32 1056
                                                 (SExt w32 (Read w8 0 s))))
                           2)))
         (Eq 0 (SRem w64 N0 3))
         (Eq 0
             (SRem w64 N1:(SDiv w64 N0 3) 3))
         (Eq 0
             (SRem w64 N2:(SDiv w64 N1 3) 3))
         (Eq false
             (Eq 0
                 (SRem w64 N3:(SDiv w64 N2 3) 3)))
         (Eq 0 (SRem w64 N3 5))]
        false)
