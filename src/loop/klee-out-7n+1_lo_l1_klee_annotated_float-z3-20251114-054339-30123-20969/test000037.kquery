array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Eq 0
             (SRem w64 N0:(SExt w64 (Add w32 1056
                                             (SExt w32 (Read w8 0 s))))
                       2))
         (Eq 0
             (SRem w64 N1:(SDiv w64 N0 2) 2))
         (Eq 0
             (SRem w64 N2:(SDiv w64 N1 2) 2))
         (Eq 0
             (SRem w64 N3:(SDiv w64 N2 2) 2))
         (Eq false
             (Eq 0
                 (SRem w64 N4:(SDiv w64 N3 2) 2)))
         (Eq false
             (Eq 0 (SRem w64 N4 3)))
         (Eq 0 (SRem w64 N4 5))]
        false)
