array choose[4] : w32 -> w8 = symbolic
array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Ult N0:(ReadLSB w32 0 choose)
              2)
         (Eq false (Eq 0 N0))
         (Eq 54 (Read w8 0 s))]
        false)
