array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Eq false
             (Ult N0:(Mul w64 4
                              (SExt w64 (Add w32 4294967248
                                                 (SExt w32 (Read w8 0 s)))))
                  37))
         (Ult (Add w64 18446744073709551344 N0) 7)]
        false)
