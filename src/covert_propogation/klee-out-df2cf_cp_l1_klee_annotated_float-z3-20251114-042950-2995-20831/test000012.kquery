array model_version[4] : w32 -> w8 = symbolic
array s[5] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 0 (Read w8 4 s))
         (Eq false
             (Eq 1
                 N0:(Extract w8 0 (SRem w32 (Add w32 4294967248
                                                     (SExt w32 (Read w8 0 s)))
                                            10))))
         (Eq false (Eq 4 N0))
         (Eq false (Eq 0 N0))
         (Eq false (Eq 3 N0))
         (Eq false (Eq 9 N0))
         (Eq false (Eq 6 N0))
         (Eq false (Eq 5 N0))
         (Eq false (Eq 2 N0))
         (Eq false (Eq 8 N0))
         (Eq false (Eq 7 N0))]
        false)
