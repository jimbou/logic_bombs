array s[5] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 4 s))
         (Eq false
             (Ult 9223372036854775807
                  N0:(SExt w64 (Add w32 4294967248
                                        (SExt w32 (Read w8 0 s))))))
         (Eq 0
             (Or w32 (UDiv w32 N1:(Extract w32 0 N0) 10)
                     (Extract w32 0 (LShr w64 N0 32))))
         (Eq false
             (Eq 48
                 (Extract w8 0 (Add w32 48 (URem w32 N1 10)))))]
        false)
