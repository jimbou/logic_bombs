array s[5] : w32 -> w8 = symbolic
(query [(Eq 0 (Read w8 4 s))
         (Eq 2
             (Extract w8 0 (SRem w32 (Add w32 4294967248
                                              (SExt w32 N0:(Read w8 0 s)))
                                     10)))
         (Eq false (Eq 60 N0))]
        false)
